---
import { Image } from 'astro:assets';
const { home, island } = Astro.props;
---
<article class="home" id={home.id}>
  <div class="frame home__photo">
    <Image src={home.photo} alt={home.alt} widths={[360, 540, 720, 960]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 44vw, 28vw" loading="lazy" style={`object-position:${home.position}`} />
  </div>
  <h4 class="home__name">{home.name}</h4>
  <p class="label home__place">{home.place} · {island}</p>
  <p class="home__line">{home.line}</p>
  <dl class="home__facts">
    <div><dt class="visually-hidden">Details</dt><dd>{home.facts}</dd></div>
    <div><dt class="visually-hidden">Price</dt><dd class="home__price">{home.price}</dd></div>
  </dl>
  <a class="link" href="#enquire" data-home={home.name}>Enquire about {home.name}</a>
</article>

<style>
  .home { display: flex; flex-direction: column; align-items: flex-start; }
  .home__photo { width: 100%; aspect-ratio: 4 / 5; }
  .home__photo :global(img) { transition: transform 900ms var(--ease-out); }
  .home:hover .home__photo :global(img) { transform: scale(1.025); }
  /* The name sits on a paper tab cut into the bottom of the photograph. */
  /* Sized so the longest name holds one line in every column layout; the tab shrink-wraps its text. */
  .home__name { position: relative; width: fit-content; max-width: 100%; margin: -0.9em 0 var(--s4); padding: 0.36em 0.6em 0.08em 0; background: var(--chalk); font: 300 italic clamp(1.75rem, 2.5vw, 2.5rem)/1 var(--serif); letter-spacing: -0.02em; }
  .home__place { color: var(--terracotta); margin-bottom: var(--s3); }
  .home__line { font: 400 var(--step-1)/1.45 var(--serif); margin-bottom: var(--s4); max-width: 26rem; text-wrap: pretty; }
  .home__facts { width: 100%; display: flex; justify-content: space-between; gap: var(--s4); flex-wrap: wrap; padding-top: var(--s3); border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--stone); font-variant-numeric: lining-nums tabular-nums; }
  .home__price { color: var(--ink); font-weight: 500; }
  .home .link { margin-top: var(--s2); }

  /* Browsers without scroll-driven animation: the page script adds .tabs-io to <html> and
     .is-in to each card as it arrives. Without the script the names are simply visible. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.tabs-io) .home__name { clip-path: inset(0 100% 0 0); translate: 0 0.5em; transition: clip-path 700ms var(--ease-out), translate 700ms var(--ease-out); }
    :global(.tabs-io) .home.is-in .home__name { clip-path: inset(0 0 0 0); translate: 0 0; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .home__name { animation: tab-in linear both; animation-timeline: view(); animation-range: entry 10% cover 34%; }
      @keyframes tab-in { from { transform: translateY(0.5em); clip-path: inset(0 100% 0 0); } to { transform: none; clip-path: inset(0 0 0 0); } }
    }
  }
</style>
